#!/usr/bin/env bash
set -euo pipefail

install_webapp_launcher() {
    local desktop_file="$1"
    local app_name="$2"
    local comment="$3"
    local app_url="$4"
    local wm_class="$5"

    echo "Creating Chromium desktop launcher for ${app_name} (${app_url})"
    cat << EOF > "${desktop_file}"
[Desktop Entry]
Name=${app_name}
Comment=${comment}
Exec=/usr/bin/chromium --app=${app_url} --class=${wm_class}
Icon=web-browser
Type=Application
Categories=Development;Utility;
StartupWMClass=${wm_class}
EOF
}

install_webapp_launcher \
    "/usr/share/applications/chatgpt-desktop.desktop" \
    "ChatGPT" \
    "OpenAI ChatGPT Workspace" \
    "https://chatgpt.com" \
    "ChatGPTDesktop"

install_webapp_launcher \
    "/usr/share/applications/claude-desktop.desktop" \
    "Claude" \
    "Anthropic Claude AI Workspace" \
    "https://claude.ai" \
    "ClaudeDesktop"

install_webapp_launcher \
    "/usr/share/applications/gemini-desktop.desktop" \
    "Google Gemini" \
    "Google Gemini AI Workspace" \
    "https://gemini.google.com" \
    "GeminiDesktop"