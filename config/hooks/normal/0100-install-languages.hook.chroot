#!/usr/bin/env bash
set -euo pipefail

export CARGO_HOME="/opt/rust/cargo"
export RUSTUP_HOME="/opt/rust/rustup"
export FNM_DIR="/opt/fnm"
export FLUTTER_ROOT="/opt/flutter"
export ANDROID_HOME="/opt/android-sdk"
export ANDROID_SDK_ROOT="${ANDROID_HOME}"

download_file() {
    local url="$1"
    local destination="$2"

    echo "Downloading ${url} -> ${destination}"
    if ! curl -fSL "${url}" -o "${destination}"; then
        echo "Error: Failed to download ${url}" >&2
        exit 1
    fi
}

install_uv() {
    local url="https://astral.sh/uv/install.sh"
    echo "Running installer from ${url}"
    curl -fSL "${url}" | env UV_INSTALL_DIR="/usr/local/bin" sh
}

install_rust() {
    local url="https://sh.rustup.rs"
    mkdir -p "${CARGO_HOME}" "${RUSTUP_HOME}"
    echo "Running installer from ${url}"
    curl --proto '=https' --tlsv1.2 -fSL "${url}" | sh -s -- -y --no-modify-path
}

install_nodejs_and_devcontainers() {
    local url="https://fnm.vercel.app/install"
    mkdir -p "${FNM_DIR}"
    echo "Running installer from ${url}"
    curl -fSL "${url}" | bash -s -- --install-dir "${FNM_DIR}" --skip-shell

    export PATH="${FNM_DIR}:${PATH}"
    eval "$("${FNM_DIR}/fnm" env)"
    "${FNM_DIR}/fnm" install --lts
    "${FNM_DIR}/fnm" default lts-latest
    npm install -g @devcontainers/cli
}

install_android_sdk() {
    local cmdline_zip="commandlinetools-linux-11076708_latest.zip"
    local url="https://dl.google.com/android/repository/${cmdline_zip}"

    mkdir -p "${ANDROID_HOME}/cmdline-tools"
    download_file "${url}" "/tmp/cmdline-tools.zip"
    unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-extract
    mv /tmp/cmdline-extract/cmdline-tools "${ANDROID_HOME}/cmdline-tools/latest"
    rm -rf /tmp/cmdline-tools.zip /tmp/cmdline-extract

    local sdkmanager="${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager"
    set +o pipefail
    yes | "${sdkmanager}" --sdk_root="${ANDROID_HOME}" --licenses >/dev/null
    set -o pipefail

    "${sdkmanager}" --sdk_root="${ANDROID_HOME}" \
        "platform-tools" \
        "platforms;android-35" \
        "build-tools;35.0.0"

    chmod -R a+rX "${ANDROID_HOME}"
}

install_flutter_and_kotlin() {
    local flutter_repo="https://github.com/flutter/flutter.git"
    echo "Cloning Flutter SDK from ${flutter_repo}"
    git clone "${flutter_repo}" -b stable --depth 1 "${FLUTTER_ROOT}"
    git config --system --add safe.directory "${FLUTTER_ROOT}"
    chmod -R a+rX "${FLUTTER_ROOT}"

    CI=true "${FLUTTER_ROOT}/bin/flutter" --disable-analytics
    CI=true "${FLUTTER_ROOT}/bin/flutter" precache --linux --android

    local kotlin_version="2.1.20"
    local kotlin_url="https://github.com/JetBrains/kotlin/releases/download/v${kotlin_version}/kotlin-compiler-${kotlin_version}.zip"
    download_file "${kotlin_url}" "/tmp/kotlin.zip"
    unzip -q /tmp/kotlin.zip -d /opt
    rm -f /tmp/kotlin.zip
}

install_uv
install_rust
install_nodejs_and_devcontainers
install_android_sdk
install_flutter_and_kotlin