#!/usr/bin/env bash
set -euo pipefail

export FNM_DIR="/opt/fnm"
export PATH="${FNM_DIR}:${PATH}"
eval "$("${FNM_DIR}/fnm" env)"

verify_antigravity_cli() {
    if ! command -v agy >/dev/null 2>&1; then
        echo "Error: agy CLI was not installed by the antigravity package." >&2
        exit 1
    fi
}

install_node_ai_clis() {
    echo "Installing @anthropic-ai/claude-code and @openai/codex via npm"
    npm install -g @anthropic-ai/claude-code @openai/codex
}

verify_antigravity_cli
install_node_ai_clis