#!/usr/bin/env bash
set -euo pipefail

export FNM_DIR="/opt/fnm"
export PATH="${FNM_DIR}:${PATH}"
eval "$("${FNM_DIR}/fnm" env)"

# The antigravity APT package ships only the IDE; agy comes from its own installer.
install_antigravity_cli() {
    local url="https://antigravity.google/cli/install.sh"
    echo "Running installer from ${url}"
    curl -fSL "${url}" | bash -s -- --dir /usr/local/bin
    rm -rf /root/.cache/antigravity

    if ! command -v agy >/dev/null 2>&1; then
        echo "Error: agy CLI was not installed to /usr/local/bin." >&2
        exit 1
    fi
}

install_node_ai_clis() {
    echo "Installing @anthropic-ai/claude-code and @openai/codex via npm"
    npm install -g @anthropic-ai/claude-code @openai/codex
}

install_antigravity_cli
install_node_ai_clis