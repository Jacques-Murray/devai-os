#!/usr/bin/env bash
set -euo pipefail

ANDROID_STUDIO_URL="${ANDROID_STUDIO_URL:-https://redirector.gvt1.com/edgedl/android/studio/ide-zips/2025.2.1.8/android-studio-2025.2.1.8-linux.tar.gz}"

download_file() {
    local url="$1"
    local destination="$2"

    echo "Downloading ${url} -> ${destination}"
    if ! curl -fSL "${url}" -o "${destination}"; then
        echo "Error: Failed to download ${url}" >&2
        exit 1
    fi
}

install_android_studio() {
    download_file "${ANDROID_STUDIO_URL}" "/tmp/android-studio.tar.gz"
    tar -xzf /tmp/android-studio.tar.gz -C /opt
    ln -sf /opt/android-studio/bin/studio /usr/local/bin/android-studio
    rm -f /tmp/android-studio.tar.gz

    cat << 'EOF' > /usr/share/applications/android-studio.desktop
[Desktop Entry]
Name=Android Studio
Comment=Android and Flutter IDE
Exec=/usr/local/bin/android-studio %f
Icon=/opt/android-studio/bin/studio.svg
Type=Application
Categories=Development;IDE;
EOF
}

install_android_studio