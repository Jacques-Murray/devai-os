#!/usr/bin/env bash
set -euo pipefail

install_antigravity_ide() {
    mkdir -p /opt/antigravity-ide
    curl -fsSL "https://antigravity.google/download/linux/ide/latest.tar.gz" -o /tmp/antigravity-ide.tar.gz
    tar -xzf /tmp/antigravity-ide.tar.gz -C /opt/antigravity-ide --strip-components=1
    ln -sf /opt/antigravity-ide/antigravity-ide /usr/local/bin/antigravity-ide
    rm -f /tmp/antigravity-ide.tar.gz

    cat << 'EOF' > /usr/share/applications/antigravity-ide.desktop
[Desktop Entry]
Name=Google Antigravity IDE
Comment=Agent-first coding environment
Exec=/usr/local/bin/antigravity-ide %F
Icon=/opt/antigravity-ide/resources/app/resources/linux/code.png
Type=Application
Categories=Development;IDE;
EOF
}

install_android_studio() {
    STUDIO_URL="https://redirector.gvt1.com/edgedl/android/studio/ide-zips/2025.2.1.8/android-studio-2025.2.1.8-linux.tar.gz"
    curl -fsSL "${STUDIO_URL}" -o /tmp/android-studio.tar.gz
    tar -xzf /tmp/android-studio.tar.gz -C /opt
    ln -sf /opt/android-studio/bin/studio /usr/local/bin/android-studio
    rm -f /tmp/android-studio.tar.gz

    cat << 'EOF' > /usr/share/applications/android-studio.desktop
[Desktop Entry]
Name=Android Studio
Comment=Android and Flutter IDE
Exec=/usr/local/bin/android-studio %f
Icon=/opt/android-studio/bin/studio.svg
Type=Application
Categories=Development;IDE;
EOF
}

install_antigravity_ide
install_android_studio